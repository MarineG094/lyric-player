<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp">
    <ImageView android:id="@+id/w_art" android:layout_width="48dp" android:layout_height="48dp" android:scaleType="centerCrop" android:src="@mipmap/ic_launcher" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="10dp" android:paddingEnd="4dp">
        <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textColor="#F1E6D8" android:textSize="14sp" android:textStyle="bold" android:text="Lyric Player" />
        <TextView android:id="@+id/w_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textColor="#A89A8A" android:textSize="12sp" android:text="Tap to open" />
    </LinearLayout>
    <ImageButton android:id="@+id/w_prev" android:layout_width="40dp" android:layout_height="40dp" android:background="@null" android:src="@android:drawable/ic_media_previous" android:contentDescription="Previous" />
    <ImageButton android:id="@+id/w_play" android:layout_width="44dp" android:layout_height="44dp" android:background="@null" android:src="@android:drawable/ic_media_play" android:contentDescription="Play or pause" />
    <ImageButton android:id="@+id/w_next" android:layout_width="40dp" android:layout_height="40dp" android:background="@null" android:src="@android:drawable/ic_media_next" android:contentDescription="Next" />
</LinearLayout>
