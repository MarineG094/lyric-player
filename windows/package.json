{
  "name": "lyric-player",
  "version": "1.0.0",
  "description": "Drop in a YouTube Music playlist and play it with lyrics and album art in a clean player.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/lyrics.test.js test/quran.test.js test/romanize.test.js test/probe.test.js test/lang.test.js test/discord.test.js test/whatsnew.test.js test/queue.test.js",
    "dist": "electron-builder --win portable nsis",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.lyricplayer.app",
    "productName": "Lyric Player",
    "files": [
      "main.js",
      "discord.js",
      "quran.js",
      "preload.js",
      "mini-preload.js",
      "ytm-preload.js",
      "renderer/**/*",
      "package.json",
      "icon.png",
      "icon.ico"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "icon.ico"
    },
    "portable": {
      "artifactName": "Lyric-Player-${version}.exe"
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "icon": "icon.png",
      "category": "AudioVideo",
      "maintainer": "NaqibC <200555248+NaqibC@users.noreply.github.com>",
      "synopsis": "YouTube Music with synced lyrics",
      "artifactName": "Lyric-Player-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lyric Player",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Lyric-Player-Setup-${version}.exe",
      "uninstallDisplayName": "Lyric Player"
    }
  },
  "author": {
    "name": "NaqibC",
    "email": "200555248+NaqibC@users.noreply.github.com"
  },
  "homepage": "https://github.com/NaqibC/lyric-player"
}
